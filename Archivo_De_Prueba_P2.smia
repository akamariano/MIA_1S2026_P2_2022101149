#----------------- 1. MKDISK -----------------
# ERROR PARAMETROS
mkdisk -param=x -size=30 -path=/home/ubuntu/Calificacion_MIA/Discos/DiscoN.mia

# ERROR PARAMETROS
mkdisk -tamanio=3000 -unit=K -path=/home/ubuntu/Calificacion_MIA/Discos/DiscoN.mia

# 50M - Disco1 (EXT2, particiones Part11..Part14)
mkdisk -size=50 -unit=M -fit=FF -path=/home/ubuntu/Calificacion_MIA/Discos/Disco1.mia

# 50M - Disco2
mkdisk -unit=k -size=51200 -fit=BF -path=/home/ubuntu/Calificacion_MIA/Discos/Disco2.mia

# 13M - Disco3 (EXT3, Part31..Part32)
mkdisk -size=13 -path=/home/ubuntu/Calificacion_MIA/Discos/Disco3.mia

# 50M - Disco4 (EXT3 para journaling)
mkdisk -size=51200 -unit=K -path=/home/ubuntu/Calificacion_MIA/Discos/Disco4.mia

# 20M - Disco5
mkdisk -size=20 -unit=M -fit=WF -path=/home/ubuntu/Calificacion_MIA/Discos/Disco5.mia

# Discos temporales (se borran)
mkdisk -size=50 -unit=M -fit=FF -path=/home/ubuntu/Calificacion_MIA/Discos/Disco6.mia
mkdisk -size=50 -unit=M -fit=FF -path=/home/ubuntu/Calificacion_MIA/Discos/Disco7.mia
mkdisk -size=51200 -unit=K -path=/home/ubuntu/Calificacion_MIA/Discos/Disco8.mia
mkdisk -size=51200 -unit=K -path=/home/ubuntu/Calificacion_MIA/Discos/Disco9.mia
mkdisk -size=51200 -unit=K -path=/home/ubuntu/Calificacion_MIA/Discos/Disco10.mia

#----------------- 2. RMDISK -----------------
# ERROR DISCO NO EXISTE
rmdisk -path=/home/ubuntu/Calificacion_MIA/Discos/DiscoN.mia

# Borrar discos temporales
rmdisk -path=/home/ubuntu/Calificacion_MIA/Discos/Disco6.mia
rmdisk -path=/home/ubuntu/Calificacion_MIA/Discos/Disco7.mia
rmdisk -path=/home/ubuntu/Calificacion_MIA/Discos/Disco8.mia
rmdisk -path=/home/ubuntu/Calificacion_MIA/Discos/Disco9.mia
rmdisk -path=/home/ubuntu/Calificacion_MIA/Discos/Disco10.mia

#----------------- 3. FDISK -----------------
# Disco 1 - 4 primarias de 10M
fdisk -type=P -unit=b -name=PartErr -size=10485760 -path=/home/ubuntu/Calificacion_MIA/Discos/DiscoN.mia -fit=BF
fdisk -type=P -unit=b -name=Part11  -size=10485760 -path=/home/ubuntu/Calificacion_MIA/Discos/Disco1.mia -fit=BF
fdisk -type=P -unit=k -name=Part12  -size=10240    -path=/home/ubuntu/Calificacion_MIA/Discos/Disco1.mia -fit=BF
fdisk -type=P -unit=M -name=Part13  -size=10       -path=/home/ubuntu/Calificacion_MIA/Discos/Disco1.mia -fit=BF
fdisk -type=P -unit=b -name=Part14  -size=10485760 -path=/home/ubuntu/Calificacion_MIA/Discos/Disco1.mia -fit=BF

# ERROR: limite de 4 particiones
fdisk -type=P -unit=b -name=PartErr -size=10485760 -path=/home/ubuntu/Calificacion_MIA/Discos/Disco1.mia -fit=BF

# Disco 3 - particiones para EXT3
fdisk -type=P -unit=m -name=PartErr -size=20 -path=/home/ubuntu/Calificacion_MIA/Discos/Disco3.mia
fdisk -type=P -unit=m -name=Part31  -size=4  -path=/home/ubuntu/Calificacion_MIA/Discos/Disco3.mia
fdisk -type=P -unit=m -name=Part32  -size=4  -path=/home/ubuntu/Calificacion_MIA/Discos/Disco3.mia
fdisk -type=P -unit=m -name=Part33  -size=1  -path=/home/ubuntu/Calificacion_MIA/Discos/Disco3.mia

# Disco 4 - una particion grande para EXT3
fdisk -type=P -unit=M -name=Part41  -size=40 -path=/home/ubuntu/Calificacion_MIA/Discos/Disco4.mia

#----------------- 4. MOUNT -----------------
# Disco 1
mount -path=/home/ubuntu/Calificacion_MIA/Discos/Disco1.mia -name=Part11
mount -path=/home/ubuntu/Calificacion_MIA/Discos/Disco1.mia -name=Part12

# ERROR: ya montada
mount -path=/home/ubuntu/Calificacion_MIA/Discos/Disco1.mia -name=Part11

# Disco 3
mount -path=/home/ubuntu/Calificacion_MIA/Discos/Disco3.mia -name=Part0
mount -path=/home/ubuntu/Calificacion_MIA/Discos/Disco3.mia -name=Part31
mount -path=/home/ubuntu/Calificacion_MIA/Discos/Disco3.mia -name=Part32

# Disco 4 - para EXT3
mount -path=/home/ubuntu/Calificacion_MIA/Discos/Disco4.mia -name=Part41

